{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cortex Kit Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "Build Cortex Kit"
    }
  ]
}
